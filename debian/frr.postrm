#!/bin/sh

set -e

case "${1}" in
	purge)
		rm -f /etc/frr/.pkg.frr.nointegrated
		rmdir /etc/frr > /dev/null 2>&1 || true

		rm -rf /run/frr
		rm -rf /var/lib/frr
		;;

	remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)

		;;

	*)
		echo "postrm called with unknown argument \`${1}'" >&2
		exit 1
		;;
esac

#DEBHELPER#

exit 0
