wait_for_service() {
	i=0
	limit=10
	echo -n "Waiting for service to be up and running "
	while ! vtysh -c "show version" 2>/dev/null | grep -qE "^FRRouting"; do
	    echo -n .
	    i=$(($i+1))
	    if [ ${i} -ge ${limit} ]; then
	        echo "Failed to start service after ${limit}s, giving up."
	        return 1
	    fi
	    sleep 1s
	done
	echo " done!"
}
