-	err = yang_new_path2(candidate->dnode, ly_native_ctx, xpath, value, 0, 0, options, NULL,
+	err = yang_new_path2(candidate->dnode, ly_native_ctx, xpath, value, 0, options, NULL,
 			     &dnode);
 	if (err) {
